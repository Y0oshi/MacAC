<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>MacAC</RootNamespace>
    <Description>MacAC engine core: plugin contract, gameplay mechanics, DAT and pak access, wire protocol, host services.</Description>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="MacAC.Sim" />
    <InternalsVisibleTo Include="MacAC.Client" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="BCnEncoder.Net" />
    <PackageReference Include="BCnEncoder.Net.ImageSharp" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="SixLabors.ImageSharp" />
    <PackageReference Include="StbImageSharp" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../MacAC.Dat/MacAC.Dat.csproj" />
  </ItemGroup>
</Project>
